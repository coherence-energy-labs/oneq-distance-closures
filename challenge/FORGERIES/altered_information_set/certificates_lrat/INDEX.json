  "claim": "for each code, no logical operator of qubit weight <= W = d-1 exists",
  "why_cnfs_not_proofs": "The CNF is small and exact; the proofs total 16 GB. A verifier who regenerates the proof from the CNF performs an INDEPENDENT re-derivation; re-reading proof bytes we produced only checks transmission. Every proof's SHA-256 is pinned here so a regenerated proof can also be compared byte-for-byte.",
  "how_to_verify": [
    "cadical --lrat --no-binary anchorN.cnf anchorN.lrat   # s UNSATISFIABLE",
    "lrat-check anchorN.cnf anchorN.lrat                   # c VERIFIED",
    "BOTH anchors must be UNSAT: the two anchored instances cover every orbit of the translation group, so both UNSAT proves absence."
  ],
  "encoding": {
    "commutation": "XOR chain per stabilizer row (v in N(S))",
    "not_a_stabilizer": "v anticommutes with >=1 logical rep (v not in S)",
    "weight": "sum of w_q = x_q OR z_q, sequential-counter cardinality <= W",
    "anchoring": "Z_ell x Z_m acts freely block-wise; every nonzero operator has a translate touching block-1 qubit 0, or lies in block 2 touching block-2 qubit 0"
  },
